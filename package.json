{
  "name": "mukoko",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "vp lint",
    "lint:turbo": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "check": "vp check",
    "fmt": "vp fmt",
    "ci:prepare": "turbo run build --filter=@mukoko/types"
  },
  "devDependencies": {
    "@mukoko/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "vp fmt --check"
    ],
    "*.{json,md,css}": [
      "vp fmt --check"
    ]
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "undici@>=7 <7.29.1": "^7.29.1",
      "undici@>=8 <8.10.2": "^8.10.2",
      "ajv": "^6.14.0",
      "@eslint/eslintrc": ">=3.3.5",
      "glob": ">=10.5.0",
      "prismjs": ">=1.30.0",
      "adm-zip": ">=0.6.1",
      "postcss": ">=8.5.23",
      "uuid": ">=11.1.1",
      "@babel/core@<7.29.6": "^7.29.6",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "^7.29.4",
      "@hono/node-server@<1.19.15": "^1.19.15",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "baseline-browser-mapping@>=2 <2.11.0": "^2.11.0",
      "body-parser@>=2 <2.3.0": "^2.3.0",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2 <2.1.7": "^2.1.7",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "dompurify@<3.4.13": "^3.4.13",
      "esbuild@<0.25.0": "^0.25.0",
      "follow-redirects@<1.16.0": "^1.16.0",
      "form-data@>=4 <4.0.6": "^4.0.6",
      "ip-address@<10.7.1": "^10.7.1",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "lodash@<4.18.0": "^4.18.0",
      "lodash-es@<4.18.0": "^4.18.0",
      "moment@<2.31.0": "^2.31.0",
      "nanoid@<3.3.18": "^3.3.18",
      "nanoid@>=4 <5.1.16": "^5.1.16",
      "path-to-regexp@>=8 <8.4.0": "^8.4.0",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4 <4.0.4": "^4.0.4",
      "postcss-selector-parser@>=7 <7.1.3": "^7.1.3",
      "qs@<6.16.0": "^6.16.0",
      "sharp@<0.35.4": "^0.35.4",
      "tar@<7.5.21": "^7.5.21",
      "valibot@<1.4.2": "^1.4.2",
      "ws@>=8 <8.21.0": "^8.21.0",
      "yaml@>=2 <2.8.3": "^2.8.3"
    }
  }
}
